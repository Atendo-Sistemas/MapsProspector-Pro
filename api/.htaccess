# MAPS-SECURITY-HARDENING-20261005
Options -Indexes
<FilesMatch "^(?:debug-linkedin|debug-service|diagnostico3|reset-opcache|migrate)\\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
