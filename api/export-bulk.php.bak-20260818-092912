<?php
/**
 * Exportação em lote da pesquisa atual para o Webhook da empresa.
 * Versão 205 — leitura de tenant independente do esquema de perfil e log privado de diagnóstico.
 *
 * POST /api/export-bulk.php
 * Body JSON: { leadIds: [1, 2, ...] }  (vazio = últimos 200 leads do tenant)
 * Resposta: { success: true, sent: N, message: ... }
 */

// --- Blindagem de saída: qualquer aviso/erro vira JSON, nunca HTML ---
ob_start();
ini_set('display_errors', '0');
error_reporting(E_ALL);
if (!headers_sent()) {
    header('Content-Type: application/json; charset=utf-8');
    header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
    header('Pragma: no-cache');
    header('Expires: 0');
    header('X-Content-Type-Options: nosniff');
    header('X-Frame-Options: SAMEORIGIN');
    header('Referrer-Policy: no-referrer');
    header('Permissions-Policy: geolocation=(), microphone=(), camera=()');
    header("Content-Security-Policy: default-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'");
    header('Strict-Transport-Security: max-age=31536000; includeSubDomains');
}
function bulkLogException(Throwable $e): void
{
    $message = sprintf(
        "[%s] %s em %s:%d\n",
        gmdate('c'),
        $e->getMessage(),
        $e->getFile(),
        $e->getLine()
    );
    @file_put_contents(__DIR__ . '/export-bulk-error.log', $message, FILE_APPEND | LOCK_EX);
}
set_exception_handler(static function (Throwable $e) {
    bulkLogException($e);
    while (ob_get_level() > 0) { ob_end_clean(); }
    if (!headers_sent()) {
        http_response_code(500);
        header('Content-Type: application/json; charset=utf-8');
    }
    echo '{"success":false,"error":"Falha no servidor ao exportar para o Webhook."}';
    exit;
});

// --- Carregamento do sistema ---
define('BASE_PATH', __DIR__ . '/../');
require_once BASE_PATH . 'config/config.php';
require_once BASE_PATH . 'config/database.php';
require_once BASE_PATH . 'includes/functions.php';

// --- Resposta padronizada ---
function bulkOk(array $data = [], string $message = ''): void
{
    while (ob_get_level() > 0) { ob_end_clean(); }
    echo json_encode(
        ['success' => true, 'data' => $data, 'message' => $message],
        JSON_UNESCAPED_UNICODE
    );
    exit;
}
function bulkFail(string $message, int $status = 400): void
{
    while (ob_get_level() > 0) { ob_end_clean(); }
    http_response_code($status);
    echo json_encode(['success' => false, 'error' => $message], JSON_UNESCAPED_UNICODE);
    exit;
}

// --- Autenticação ---
if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    bulkFail('Método não permitido.', 405);
}
if (!requireAuth()) {
    bulkFail('Sessão expirada. Faça login novamente.', 401);
}
$user = getAuthUser();
if (!$user) {
    bulkFail('Sessão expirada. Faça login novamente.', 401);
}

// --- Tenant e URL do Webhook ---
$pdo = null;
try {
    $pdo = Database::getInstance()->getConnection();
} catch (\Throwable $e) {
    bulkFail('Conexão com o banco indisponível.', 503);
}

// Não selecione uma coluna de perfil específica: instalações antigas podem
// usar profile, role ou user_type (ou não guardar esse campo em users).
$tenantId = (int)($user['tenant_id'] ?? $user['tenantId'] ?? 0);
$profile = strtolower((string)($user['profile'] ?? $user['role'] ?? $user['user_type'] ?? ''));
$isSuperAdmin = $profile === 'super_admin';

// A sessão pode trazer somente o id. Nesse caso, busque apenas a coluna que
// é obrigatória para a exportação, sem depender do esquema de permissões.
if ($tenantId <= 0 && !empty($user['id'])) {
    $st = $pdo->prepare('SELECT tenant_id FROM users WHERE id = ? LIMIT 1');
    $st->execute([(int)$user['id']]);
    $tenantId = (int)($st->fetchColumn() ?: 0);
}

// O super admin não tem tenant próprio. Se ele não estiver em modo
// "acessar empresa" (impersonate), o body pode informar o tenant alvo
// que ele deseja exportar (permitido somente para super_admin).
$input = json_decode((string)file_get_contents('php://input'), true);
if (!is_array($input)) { $input = []; }

if ($tenantId <= 0) {
    if ($isSuperAdmin && (int)($input['tenantId'] ?? 0) > 0) {
        $tenantId = (int)$input['tenantId'];
    } elseif ($isSuperAdmin) {
        // Super admin sem tenant informado: sugere verificar empresas
        $st = $pdo->prepare('SELECT id FROM tenants WHERE status != \'inativo\' ORDER BY id LIMIT 1');
        $st->execute();
        $fallback = (int)($st->fetchColumn() ?: 0);
        if ($fallback > 0) {
            bulkFail('Use o painel de empresas para entrar na empresa antes de exportar (ou informe tenantId no pedido).');
        }
        bulkFail('Conta não associada a uma empresa.');
    } else {
        bulkFail('Conta não associada a uma empresa. Contate o administrador.');
    }
}
if (!$isSuperAdmin && (int)($input['tenantId'] ?? 0) > 0) {
    // Usuário comum não pode trocar de tenant pelo pedido: ignora e usa o dele.
}

$st = $pdo->prepare('SELECT name, webhook_url FROM tenants WHERE id = ? LIMIT 1');
$st->execute([$tenantId]);
$row = $st->fetch(PDO::FETCH_ASSOC);
$companyWebhookUrl = trim((string)($row['webhook_url'] ?? ''));
$tenantName = (string)($row['name'] ?? '');

// Ordem de prioridade: URL individual do usuário que exporta, URL geral da
// empresa e, por último, URL geral configurada pelo super administrador.
$personalWebhookUrl = '';
if (!empty($user['id'])) {
    $st = $pdo->prepare('SELECT base_url FROM settings WHERE user_id = ? LIMIT 1');
    $st->execute([(int)$user['id']]);
    $personalWebhookUrl = trim((string)($st->fetchColumn() ?: ''));
}
$platformWebhookUrl = '';
if (function_exists('getPlatformSetting')) {
    $platformWebhookUrl = trim((string)(getPlatformSetting($pdo, 'webhook_default_url') ?? ''));
}
$webhookUrl = $personalWebhookUrl !== '' ? $personalWebhookUrl : ($companyWebhookUrl !== '' ? $companyWebhookUrl : $platformWebhookUrl);
if ($webhookUrl === '') {
    bulkFail('Configure seu webhook, o webhook da empresa ou o webhook geral da plataforma para usar esta função.');
}
if (!filter_var($webhookUrl, FILTER_VALIDATE_URL)) {
    bulkFail('A URL do Webhook configurada não é válida.');
}

// --- Seleção dos leads ---
$ids = [];
if (is_array($input['leadIds'] ?? null)) {
    foreach ($input['leadIds'] as $v) {
        $n = (int)preg_replace('/[^0-9]/', '', (string)$v);
        if ($n > 0) { $ids[] = $n; }
    }
}

if ($ids !== []) {
    $ph = implode(',', array_fill(0, count($ids), '?'));
    $st = $pdo->prepare(
        "SELECT l.*, sh.location AS search_location, sh.tag AS search_tag
         FROM leads l
         INNER JOIN search_history sh ON sh.id = l.search_history_id
         INNER JOIN users lead_owner ON lead_owner.id = sh.user_id
         WHERE l.id IN ($ph) AND lead_owner.tenant_id = ?
         ORDER BY l.id"
    );
    $st->execute(array_merge($ids, [$tenantId]));
} else {
    $st = $pdo->prepare(
        'SELECT l.*, sh.location AS search_location, sh.tag AS search_tag
         FROM leads l
         INNER JOIN search_history sh ON sh.id = l.search_history_id
         INNER JOIN users lead_owner ON lead_owner.id = sh.user_id
         WHERE lead_owner.tenant_id = ?
         ORDER BY l.id DESC
         LIMIT 200'
    );
    $st->execute([$tenantId]);
}
$leads = $st->fetchAll(PDO::FETCH_ASSOC);
if ($leads === []) {
    bulkFail('Nenhum lead encontrado para exportar.');
}

$items = [];
foreach ($leads as $lead) {
    $items[] = [
        'leadId'     => (int)$lead['id'],
        'nome'       => $lead['name'] ?? '',
        'telefone'   => $lead['phone'] ?? '',
        'endereco'   => $lead['address'] ?? '',
        'segmento'   => $lead['tag'] ?? $lead['search_tag'] ?? '',
        'cidade'     => $lead['search_location'] ?? '',
        'estado'     => '',
        'email'      => $lead['email'] ?? '',
        'site'       => $lead['website'] ?? '',
        'cnpj'       => $lead['cnpj'] ?? '',
        'mapsUri'    => $lead['maps_uri'] ?? '',
        'dataCaptura' => $lead['created_at'] ?? null,
    ];
}

// --- Auditoria (tabela opcional) ---
$logId = null;
try {
    $st = $pdo->prepare("INSERT INTO webhook_exports (tenant_id, user_id, lead_ids, payload, status, created_at) VALUES (?, ?, ?, ?, 'pending', CURRENT_TIMESTAMP)");
    $st->execute([
        $tenantId,
        (int)$user['id'],
        json_encode(array_column($leads, 'id')),
        json_encode(['tenant' => $tenantName, 'items' => $items], JSON_UNESCAPED_UNICODE),
    ]);
    $logId = (int)$pdo->lastInsertId();
} catch (\Throwable $e) { /* tabela inexistente: segue */ }

// --- Envio ao Webhook ---
$payload = json_encode(['tenant' => $tenantName, 'items' => $items], JSON_UNESCAPED_UNICODE);
$sent = 0;
$httpStatus = 0;
$falha = null;
if (!function_exists('curl_init')) {
    $falha = 'Extensão cURL indisponível no servidor.';
} else {
    $ch = curl_init($webhookUrl);
    if ($ch === false) {
        $falha = 'Falha ao iniciar o envio ao Webhook.';
    } else {
        curl_setopt_array($ch, [
            CURLOPT_POST => true,
            CURLOPT_POSTFIELDS => $payload,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_TIMEOUT => 30,
            CURLOPT_HTTPHEADER => ['Content-Type: application/json', 'Accept: application/json'],
        ]);
        $resp = (string)curl_exec($ch);
        if (curl_errno($ch) !== 0) {
            $falha = 'Falha de conexão com o Webhook: ' . curl_error($ch);
        } else {
            $httpStatus = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
            if ($httpStatus < 200 || $httpStatus >= 400) {
                $falha = 'O Webhook rejeitou o envio (HTTP ' . $httpStatus . '). Verifique a URL configurada em Configurações.';
            } else {
                $sent = count($items);
            }
        }
        curl_close($ch);
    }
}

// --- Atualiza auditoria ---
if ($logId !== null) {
    try {
        $st = $pdo->prepare("UPDATE webhook_exports SET status = ?, http_status = ?, response = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?");
        $st->execute([$falha ? 'failed' : 'sent', (int)$httpStatus, mb_substr((string)($resp ?? ''), 0, 2000), $logId]);
    } catch (\Throwable $e) { /* silencioso */ }
}

if ($falha !== null) {
    bulkFail($falha, 502);
}

$mensagem = $sent === 1 ? '1 lead enviado para o Webhook.' : "$sent leads enviados para o Webhook.";
bulkOk(['sent' => $sent, 'httpStatus' => $httpStatus], $mensagem);
