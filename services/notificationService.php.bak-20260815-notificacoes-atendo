    /**
     * Envia mensagem via WhatsApp usando a API do Atendo
     */
    public static function sendWhatsApp($db, $phone, $message) {
        $apiUrl = getPlatformSetting($db, 'whatsapp_api_url');
        $apiToken = getPlatformSetting($db, 'whatsapp_api_token');

        if (empty($apiUrl) || empty($apiToken)) return false;

        $cleanPhone = preg_replace('/[^0-9]/', '', $phone);
        if (strlen($cleanPhone) === 11) {
            $cleanPhone = '55' . $cleanPhone;
        }

        $payload = json_encode([
            'number' => $cleanPhone . '@s.whatsapp.net', // Algumas instâncias exigem o sufixo @s.whatsapp.net
            'body' => $message
        ]);

        $curl = curl_init();
        curl_setopt_array($curl, [
            CURLOPT_URL => trim($apiUrl),
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_POST => true,
            CURLOPT_POSTFIELDS => $payload,
            CURLOPT_TIMEOUT => 15, // Aumentei para 15s para evitar timeout
            CURLOPT_HTTPHEADER => [
                'Content-Type: application/json',
                'Authorization: Bearer ' . trim($apiToken),
                'apikey: ' . trim($apiToken)
            ],
        ]);

        $response = curl_exec($curl);
        $httpCode = curl_getinfo($curl, CURLINFO_HTTP_CODE);
        $err = curl_error($curl);
        curl_close($curl);
if ($httpCode >= 200 && $httpCode < 300) {
                return true;
            } else {
                error_log("API ATENDO DEVOLVEU ERRO $httpCode: " . $response);
                return false;
            }
    }
    /**
     * Envia e-mail formatado usando SMTP autenticado ou função nativa mail() como fallback
     */
    public static function sendEmail($db, $to, $subject, $messageHtml) {
        $host = getPlatformSetting($db, 'smtp_host');
        $port = (int)(getPlatformSetting($db, 'smtp_port') ?: 587);
        $user = getPlatformSetting($db, 'smtp_user');
        $pass = getPlatformSetting($db, 'smtp_pass');
        $secure = getPlatformSetting($db, 'smtp_secure') ?: 'tls';
        $fromEmail = getPlatformSetting($db, 'smtp_from_email') ?: 'noreply@atendo.log.br';
        $fromName = getPlatformSetting($db, 'smtp_from_name') ?: 'Maps Prospector';

        // Se o SMTP não estiver configurado, usa a função nativa mail() do cPanel (Fallback de segurança)
        if (empty($host) || empty($user) || empty($pass)) {
            $headers = "MIME-Version: 1.0" . "\r\n";
            $headers .= "Content-type:text/html;charset=UTF-8" . "\r\n";
            $headers .= "From: =?UTF-8?B?" . base64_encode($fromName) . "?= <" . $fromEmail . ">\r\n";
            return @mail($to, $subject, $messageHtml, $headers);
        }

        // Cliente SMTP leve escrito em PHP puro (via sockets)
        try {
            $connectionHost = ($secure === 'ssl' ? 'ssl://' : '') . $host;
            $socket = @fsockopen($connectionHost, $port, $errno, $errstr, 10);
            
            if (!$socket) {
                error_log("NotificationService SMTP Connection Error: $errstr ($errno)");
                return false;
            }

            fgets($socket, 512); // Lê o banner inicial do servidor
            
            fwrite($socket, "EHLO " . $_SERVER['SERVER_NAME'] . "\r\n");
            fgets($socket, 512);

            if ($secure === 'tls') {
                fwrite($socket, "STARTTLS\r\n");
                fgets($socket, 512);
                if (!stream_socket_enable_crypto($socket, true, STREAM_CRYPTO_METHOD_TLS_CLIENT)) {
                    error_log("NotificationService SMTP: Falha ao iniciar encriptação TLS.");
                    fclose($socket);
                    return false;
                }
                fwrite($socket, "EHLO " . $_SERVER['SERVER_NAME'] . "\r\n");
                fgets($socket, 512);
            }

            // Autenticação SMTP
            fwrite($socket, "AUTH LOGIN\r\n");
            fgets($socket, 512);
            fwrite($socket, base64_encode($user) . "\r\n");
            fgets($socket, 512);
            fwrite($socket, base64_encode($pass) . "\r\n");
            $response = fgets($socket, 512);

            if (strpos($response, '235') === false) {
                error_log("NotificationService SMTP: Falha na autenticação (Usuário/Senha incorretos).");
                fclose($socket);
                return false;
            }

            // Define Remetente e Destinatário
            fwrite($socket, "MAIL FROM: <$fromEmail>\r\n");
            fgets($socket, 512);
            fwrite($socket, "RCPT TO: <$to>\r\n");
            fgets($socket, 512);

            // Envia o Corpo do E-mail
            fwrite($socket, "DATA\r\n");
            fgets($socket, 512);

            $headers = "MIME-Version: 1.0\r\n";
            $headers .= "Content-Type: text/html; charset=UTF-8\r\n";
            $headers .= "From: =?UTF-8?B?" . base64_encode($fromName) . "?= <$fromEmail>\r\n";
            $headers .= "To: <$to>\r\n";
            $headers .= "Subject: =?UTF-8?B?" . base64_encode($subject) . "?=\r\n\r\n";

            fwrite($socket, $headers . $messageHtml . "\r\n.\r\n");
            fgets($socket, 512);

            fwrite($socket, "QUIT\r\n");
            fclose($socket);
            return true;

        } catch (Exception $e) {
            error_log("NotificationService SMTP Exception: " . $e->getMessage());
            return false;
        }
    }

