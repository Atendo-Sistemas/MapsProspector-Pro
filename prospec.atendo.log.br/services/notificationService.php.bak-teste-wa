<?php
/**
 * Serviço central de notificações da plataforma.
 *
 * O WhatsApp utiliza exclusivamente a API atual da Atendo, configurada nas
 * chaves globais atendo_wa_base_url, atendo_wa_token e atendo_wa_admin_number.
 * Nenhuma credencial é devolvida ao navegador.
 */
class NotificationService
{
    private const DISPATCH_RETRY_MINUTES = 30;

    /**
     * Envia uma mensagem pela API Atendo e registra o estado de cada evento.
     * O envio falha de forma segura: nunca lança exceção para o fluxo de negócio.
     */
    public static function sendWhatsApp(PDO $db, string $phone, string $message, string $externalKey = ''): bool
    {
        $apiUrl = trim((string) getPlatformSetting($db, 'atendo_wa_base_url'));
        $apiToken = trim((string) getPlatformSetting($db, 'atendo_wa_token'));
        $number = self::normalizeBrazilianPhone($phone);

        if ($apiUrl === '' || $apiToken === '' || $number === '' || trim($message) === '') {
            error_log('NotificationService WhatsApp: configuração, destinatário ou mensagem inválidos.');
            return false;
        }

        if ($externalKey !== '' && !self::claimWhatsAppDispatch($db, $externalKey, null)) {
            return false;
        }

        if (!function_exists('curl_init')) {
            self::finishWhatsAppDispatch($db, $externalKey, false, 'Extensão cURL indisponível.');
            error_log('NotificationService WhatsApp: extensão cURL indisponível.');
            return false;
        }

        $payload = json_encode([
            'number' => $number,
            'body' => trim($message),
            'externalKey' => $externalKey !== '' ? $externalKey : self::makeEventKey('message', [$number, microtime(true)]),
        ], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);

        if ($payload === false) {
            self::finishWhatsAppDispatch($db, $externalKey, false, 'Não foi possível codificar a mensagem.');
            return false;
        }

        $curl = curl_init();
        curl_setopt_array($curl, [
            CURLOPT_URL => $apiUrl,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_POST => true,
            CURLOPT_POSTFIELDS => $payload,
            CURLOPT_CONNECTTIMEOUT => 3,
            CURLOPT_TIMEOUT => 8,
            CURLOPT_HTTPHEADER => [
                'Content-Type: application/json; charset=utf-8',
                'Authorization: Bearer ' . $apiToken,
            ],
        ]);

        $response = curl_exec($curl);
        $httpCode = (int) curl_getinfo($curl, CURLINFO_HTTP_CODE);
        $curlError = (string) curl_error($curl);
        curl_close($curl);

        $success = $response !== false && $httpCode >= 200 && $httpCode < 300;
        if ($success) {
            self::finishWhatsAppDispatch($db, $externalKey, true);
            return true;
        }

        $error = $curlError !== '' ? $curlError : 'Resposta HTTP ' . $httpCode;
        self::finishWhatsAppDispatch($db, $externalKey, false, $error);
        error_log('NotificationService WhatsApp: falha no envio. HTTP=' . $httpCode . ', evento=' . ($externalKey !== '' ? $externalKey : 'sem-chave'));
        return false;
    }

    /** Normaliza telefones brasileiros para DDI + DDD + número, sem sufixos de instância. */
    public static function normalizeBrazilianPhone(string $phone): string
    {
        $digits = preg_replace('/\D+/', '', $phone);
        if ($digits === null) {
            return '';
        }

        if (str_starts_with($digits, '00')) {
            $digits = substr($digits, 2);
        }

        if (strlen($digits) === 10 || strlen($digits) === 11) {
            $digits = '55' . $digits;
        }

        return (strlen($digits) === 12 || strlen($digits) === 13) && str_starts_with($digits, '55')
            ? $digits
            : '';
    }

    /**
     * Envia e-mail por SMTP autenticado ou usa mail() como contingência.
     */
    public static function sendEmail(PDO $db, string $to, string $subject, string $messageHtml): bool
    {
        $host = trim((string) getPlatformSetting($db, 'smtp_host'));
        $port = (int) (getPlatformSetting($db, 'smtp_port') ?: 587);
        $user = trim((string) getPlatformSetting($db, 'smtp_user'));
        $pass = (string) getPlatformSetting($db, 'smtp_pass');
        $secure = strtolower(trim((string) (getPlatformSetting($db, 'smtp_secure') ?: 'tls')));
        $fromEmail = trim((string) (getPlatformSetting($db, 'smtp_from_email') ?: 'noreply@atendo.log.br'));
        $fromName = trim((string) (getPlatformSetting($db, 'smtp_from_name') ?: self::platformName($db)));

        if (!filter_var($to, FILTER_VALIDATE_EMAIL)) {
            return false;
        }

        if ($host === '' || $user === '' || $pass === '') {
            $headers = "MIME-Version: 1.0\r\n";
            $headers .= "Content-type: text/html; charset=UTF-8\r\n";
            $headers .= 'From: =?UTF-8?B?' . base64_encode($fromName) . '?= <' . $fromEmail . ">\r\n";
            return @mail($to, $subject, $messageHtml, $headers);
        }

        try {
            $connectionHost = $secure === 'ssl' ? 'ssl://' . $host : $host;
            $socket = @fsockopen($connectionHost, $port, $errno, $errorText, 10);
            if (!$socket) {
                error_log('NotificationService SMTP: conexão indisponível.');
                return false;
            }

            fgets($socket, 512);
            fwrite($socket, 'EHLO ' . ($_SERVER['SERVER_NAME'] ?? 'localhost') . "\r\n");
            fgets($socket, 512);

            if ($secure === 'tls') {
                fwrite($socket, "STARTTLS\r\n");
                fgets($socket, 512);
                if (!stream_socket_enable_crypto($socket, true, STREAM_CRYPTO_METHOD_TLS_CLIENT)) {
                    fclose($socket);
                    error_log('NotificationService SMTP: falha ao iniciar TLS.');
                    return false;
                }
                fwrite($socket, 'EHLO ' . ($_SERVER['SERVER_NAME'] ?? 'localhost') . "\r\n");
                fgets($socket, 512);
            }

            fwrite($socket, "AUTH LOGIN\r\n");
            fgets($socket, 512);
            fwrite($socket, base64_encode($user) . "\r\n");
            fgets($socket, 512);
            fwrite($socket, base64_encode($pass) . "\r\n");
            $authResponse = (string) fgets($socket, 512);
            if (!str_contains($authResponse, '235')) {
                fclose($socket);
                error_log('NotificationService SMTP: autenticação recusada.');
                return false;
            }

            fwrite($socket, "MAIL FROM: <{$fromEmail}>\r\n");
            fgets($socket, 512);
            fwrite($socket, "RCPT TO: <{$to}>\r\n");
            fgets($socket, 512);
            fwrite($socket, "DATA\r\n");
            fgets($socket, 512);

            $headers = "MIME-Version: 1.0\r\n";
            $headers .= "Content-Type: text/html; charset=UTF-8\r\n";
            $headers .= 'From: =?UTF-8?B?' . base64_encode($fromName) . '?= <' . $fromEmail . ">\r\n";
            $headers .= "To: <{$to}>\r\n";
            $headers .= 'Subject: =?UTF-8?B?' . base64_encode($subject) . "?=\r\n\r\n";
            fwrite($socket, $headers . $messageHtml . "\r\n.\r\n");
            fgets($socket, 512);
            fwrite($socket, "QUIT\r\n");
            fclose($socket);
            return true;
        } catch (Throwable $e) {
            error_log('NotificationService SMTP: envio não concluído.');
            return false;
        }
    }

    /** Confirma o cadastro por e-mail e WhatsApp; nunca inclui senha. */
    public static function notifyNewRegistration(PDO $db, string $companyName, string $adminEmail, ?string $adminPhone = null): void
    {
        $platform = self::platformName($db);
        $company = self::html($companyName);
        $subject = 'Cadastro confirmado em ' . $platform;
        $email = '<div style="font-family:Arial,sans-serif;color:#1e293b;max-width:600px;margin:0 auto;padding:20px;border:1px solid #e2e8f0;border-radius:10px">'
            . '<h2 style="color:#2563eb">Cadastro confirmado</h2>'
            . '<p>A empresa <strong>' . $company . '</strong> foi cadastrada com sucesso em <strong>' . self::html($platform) . '</strong>.</p>'
            . '<p>Use o e-mail informado no cadastro para acessar seu painel e iniciar as prospecções.</p>'
            . '<p style="margin-top:30px;font-size:12px;color:#64748b">Atenciosamente,<br>Equipe ' . self::html($platform) . ' — Atendo Sistemas</p></div>';
        self::sendEmail($db, $adminEmail, $subject, $email);

        if ($adminPhone !== null && $adminPhone !== '') {
            $message = 'Olá. O cadastro da empresa *' . $companyName . '* foi confirmado em *' . $platform . '*. Use o seu e-mail cadastrado para acessar o painel e iniciar as prospecções.';
            self::sendWhatsApp($db, $adminPhone, $message, self::makeEventKey('registration', [$adminEmail, $companyName]));
        }
    }

    /** Avisa o administrador global sobre uma solicitação de plano. */
    public static function notifyPlanRequest(PDO $db, string $companyName, string $planName): void
    {
        $adminEmail = self::platformAdminEmail($db);
        $subject = 'Solicitação de plano: ' . $companyName;
        $html = '<p>A empresa <strong>' . self::html($companyName) . '</strong> solicitou o plano <strong>' . self::html($planName) . '</strong>.</p>';
        self::sendEmail($db, $adminEmail, $subject, $html);
        self::sendWhatsApp($db, self::platformAdminNumber($db), 'Nova solicitação de plano: *' . $companyName . '* solicitou *' . $planName . '*.', self::makeEventKey('plan-request', [$companyName, $planName]));
    }

    /** Avisa o cliente quando a alteração de plano é aprovada. */
    public static function notifyPlanApproval(PDO $db, string $companyName, string $planName, string $clientEmail, ?string $clientPhone = null): void
    {
        $platform = self::platformName($db);
        self::sendEmail($db, $clientEmail, 'Plano ativado em ' . $platform, '<p>O plano da empresa <strong>' . self::html($companyName) . '</strong> foi atualizado para <strong>' . self::html($planName) . '</strong>. Os novos limites já estão ativos.</p>');
        if ($clientPhone !== null && $clientPhone !== '') {
            self::sendWhatsApp($db, $clientPhone, 'Olá. O plano da empresa *' . $companyName . '* foi atualizado para *' . $planName . '*. Os novos limites já estão ativos no painel.', self::makeEventKey('plan-approved', [$clientEmail, $planName]));
        }
    }

    /** Avisa o administrador global sobre uma solicitação de créditos. */
    public static function notifyCreditRequest(PDO $db, string $companyName, int $credits): void
    {
        $adminEmail = self::platformAdminEmail($db);
        self::sendEmail($db, $adminEmail, 'Solicitação de créditos: ' . $companyName, '<p>A empresa <strong>' . self::html($companyName) . '</strong> solicitou <strong>' . (int) $credits . ' créditos</strong>.</p>');
        self::sendWhatsApp($db, self::platformAdminNumber($db), 'Nova solicitação de créditos: *' . $companyName . '* solicitou *' . (int) $credits . ' créditos*.', self::makeEventKey('credit-request', [$companyName, (string) $credits]));
    }

    /** Avisa o cliente quando créditos adicionais são liberados. */
    public static function notifyCreditApproval(PDO $db, string $companyName, int $credits, string $clientEmail, ?string $clientPhone = null): void
    {
        $platform = self::platformName($db);
        self::sendEmail($db, $clientEmail, 'Créditos liberados em ' . $platform, '<p>Foram liberados <strong>' . (int) $credits . ' créditos adicionais</strong> para a empresa <strong>' . self::html($companyName) . '</strong>.</p>');
        if ($clientPhone !== null && $clientPhone !== '') {
            self::sendWhatsApp($db, $clientPhone, 'Olá. A solicitação de *' . (int) $credits . ' créditos adicionais* para *' . $companyName . '* foi aprovada. O saldo já está disponível no painel.', self::makeEventKey('credits-approved', [$clientEmail, (string) $credits]));
        }
    }

    /**
     * Avisa uma única vez por período quando o saldo disponível fica em 10% ou menos.
     */
    public static function notifyLowBalance(PDO $db, int $tenantId, string $clientPhone, string $companyName, int $usedTokens, int $totalTokens, string $periodStart): bool
    {
        if ($tenantId <= 0 || $totalTokens <= 0 || self::normalizeBrazilianPhone($clientPhone) === '') {
            return false;
        }

        $remaining = max(0, $totalTokens - max(0, $usedTokens));
        $remainingPercent = ($remaining / $totalTokens) * 100;
        if ($remainingPercent > 10) {
            return false;
        }

        $platform = self::platformName($db);
        $message = 'Olá. O saldo de créditos da empresa *' . $companyName . '* em *' . $platform . '* está baixo: restam *' . $remaining . ' de ' . $totalTokens . ' créditos* (' . (int) floor($remainingPercent) . '%). Acesse o painel para solicitar créditos e evitar interrupções.';
        $eventKey = self::makeEventKey('low-balance-10', [$tenantId, $periodStart]);

        // Dentro da transação apenas cria a reserva. O endpoint volta a chamar
        // esta rotina após o commit para efetivar a entrega do mesmo evento.
        if ($db->inTransaction()) {
            return self::queueWhatsAppDispatch($db, $eventKey, $tenantId);
        }

        return self::sendWhatsApp($db, $clientPhone, $message, $eventKey);
    }

    /**
     * Efetiva o evento reservado apenas depois que a resposta do endpoint foi
     * entregue. Em PHP-FPM, fastcgi_finish_request() desacopla o cURL da tela
     * do usuário; em outros SAPIs o limite curto do serviço continua seguro.
     */
    public static function deferLowBalanceDispatch(PDO $db, int $tenantId, string $clientPhone, string $companyName, int $usedTokens, int $totalTokens, string $periodStart): void
    {
        static $scheduledEvents = [];
        $eventKey = self::makeEventKey('low-balance-10', [$tenantId, $periodStart]);
        if (isset($scheduledEvents[$eventKey])) {
            return;
        }
        $scheduledEvents[$eventKey] = true;

        register_shutdown_function(static function () use ($db, $tenantId, $clientPhone, $companyName, $usedTokens, $totalTokens, $periodStart): void {
            if (function_exists('fastcgi_finish_request')) {
                @fastcgi_finish_request();
            }

            try {
                self::notifyLowBalance($db, $tenantId, $clientPhone, $companyName, $usedTokens, $totalTokens, $periodStart);
            } catch (Throwable $e) {
                error_log('NotificationService: alerta pós-resposta não enviado.');
            }
        });
    }

    /** Retorna contato administrativo principal do tenant para alertas transacionais. */
    public static function getTenantNotificationContact(PDO $db, int $tenantId): ?array
    {
        try {
            $stmt = $db->prepare(
                "SELECT t.name AS company_name, u.name AS user_name, u.email, u.phone
                 FROM tenants t
                 INNER JOIN users u ON u.tenant_id = t.id
                 WHERE t.id = ?
                 ORDER BY CASE WHEN u.profile = 'admin' THEN 0 WHEN u.profile IN ('manager', 'gerente', 'supervisor') THEN 1 ELSE 2 END, u.id ASC
                 LIMIT 1"
            );
            $stmt->execute([$tenantId]);
            $row = $stmt->fetch(PDO::FETCH_ASSOC);
            return is_array($row) ? $row : null;
        } catch (Throwable $e) {
            error_log('NotificationService: contato do tenant indisponível.');
            return null;
        }
    }

    private static function platformName(PDO $db): string
    {
        return trim((string) (getPlatformSetting($db, 'platform_name') ?: getPlatformSetting($db, 'saas_company_name') ?: 'Maps Prospector'));
    }

    private static function platformAdminEmail(PDO $db): string
    {
        return trim((string) (getPlatformSetting($db, 'atendo_wa_admin_email') ?: 'admin@atendo.log.br'));
    }

    private static function platformAdminNumber(PDO $db): string
    {
        return trim((string) getPlatformSetting($db, 'atendo_wa_admin_number'));
    }

    private static function html(string $value): string
    {
        return htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
    }

    private static function makeEventKey(string $prefix, array $parts): string
    {
        return $prefix . '-' . substr(hash('sha256', implode('|', array_map(static fn($part) => (string) $part, $parts))), 0, 40);
    }

    private static function ensureDispatchTable(PDO $db): bool
    {
        static $tableAvailable = null;

        if ($tableAvailable !== null) {
            return $tableAvailable;
        }

        try {
            $db->query('SELECT 1 FROM notification_dispatches LIMIT 1');
            $tableAvailable = true;
            return true;
        } catch (Throwable $missingTable) {
            // CREATE TABLE provoca commit implícito no MySQL. Nunca execute DDL
            // enquanto uma busca ainda estiver dentro da transação de créditos.
            if ($db->inTransaction()) {
                error_log('NotificationService: tabela notification_dispatches ausente durante transação. Execute o SQL de instalação antes de ativar alertas.');
                $tableAvailable = false;
                return false;
            }
        }

        try {
            $db->exec(
                "CREATE TABLE IF NOT EXISTS notification_dispatches (
                    event_key VARCHAR(100) NOT NULL PRIMARY KEY,
                    tenant_id BIGINT NULL,
                    channel VARCHAR(24) NOT NULL,
                    status VARCHAR(24) NOT NULL,
                    attempts INT NOT NULL DEFAULT 0,
                    last_error VARCHAR(500) NULL,
                    created_at DATETIME NOT NULL,
                    updated_at DATETIME NOT NULL,
                    sent_at DATETIME NULL,
                    INDEX idx_notification_dispatches_tenant_status (tenant_id, status)
                ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci"
            );
            $tableAvailable = true;
            return $tableAvailable;
        } catch (Throwable $e) {
            error_log('NotificationService: tabela de controle indisponível.');
            $tableAvailable = false;
            return $tableAvailable;
        }
    }

    /** Reserva a entrega; eventos enviados não voltam a ser enviados no mesmo ciclo. */
    private static function claimWhatsAppDispatch(PDO $db, string $eventKey, ?int $tenantId): bool
    {
        if (!self::ensureDispatchTable($db)) {
            return false;
        }

        try {
            $insert = $db->prepare(
                "INSERT IGNORE INTO notification_dispatches (event_key, tenant_id, channel, status, attempts, created_at, updated_at)
                 VALUES (?, ?, 'whatsapp', 'processing', 1, NOW(), NOW())"
            );
            $insert->execute([$eventKey, $tenantId]);
            if ($insert->rowCount() === 1) {
                return true;
            }

            $retry = $db->prepare(
                "UPDATE notification_dispatches
                 SET status = 'processing', attempts = attempts + 1, last_error = NULL, updated_at = NOW()
                 WHERE event_key = ?
                   AND (
                        status = 'queued'
                        OR (status = 'failed' AND updated_at < DATE_SUB(NOW(), INTERVAL " . self::DISPATCH_RETRY_MINUTES . " MINUTE))
                   )"
            );
            $retry->execute([$eventKey]);
            return $retry->rowCount() === 1;
        } catch (Throwable $e) {
            error_log('NotificationService: não foi possível reservar a entrega.');
            return true;
        }
    }

    /** Registra a entrega para disparo depois que a transação principal confirmar. */
    private static function queueWhatsAppDispatch(PDO $db, string $eventKey, int $tenantId): bool
    {
        if (!self::ensureDispatchTable($db)) {
            return false;
        }

        try {
            $stmt = $db->prepare(
                "INSERT IGNORE INTO notification_dispatches (event_key, tenant_id, channel, status, attempts, created_at, updated_at)
                 VALUES (?, ?, 'whatsapp', 'queued', 0, NOW(), NOW())"
            );
            $stmt->execute([$eventKey, $tenantId]);
            return $stmt->rowCount() === 1;
        } catch (Throwable $e) {
            error_log('NotificationService: alerta de saldo não enfileirado.');
            return false;
        }
    }

    private static function finishWhatsAppDispatch(PDO $db, string $eventKey, bool $success, string $error = ''): void
    {
        if ($eventKey === '') {
            return;
        }

        try {
            $stmt = $db->prepare(
                "UPDATE notification_dispatches
                 SET status = ?, last_error = ?, updated_at = NOW(), sent_at = CASE WHEN ? = 1 THEN NOW() ELSE sent_at END
                 WHERE event_key = ?"
            );
            $stmt->execute([$success ? 'sent' : 'failed', $success ? null : mb_substr($error, 0, 500), $success ? 1 : 0, $eventKey]);
        } catch (Throwable $e) {
            error_log('NotificationService: status da entrega não registrado.');
        }
    }
}
